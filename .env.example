# Browser-safe values (Vite embeds VITE_* variables into the public bundle).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_API_URL=http://localhost:8000

# Backend-only values. Never use these with a VITE_ prefix.
DATABASE_URL=sqlite:///./prashna.db
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Optional compatibility for legacy HS256 Supabase projects; prefer JWKS signing keys.
SUPABASE_JWT_SECRET=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Do not place SUPABASE_SERVICE_ROLE_KEY in this app's frontend. The API verifies
# user JWTs and uses DATABASE_URL; a service-role key is not needed for normal use.
